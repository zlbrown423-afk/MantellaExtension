{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Living World personality profiles",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "default_mode": {
      "enum": [
        "manual",
        "automatic",
        "hybrid"
      ]
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libido": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "sexual_confidence": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "initiation": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "selectiveness": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "privacy": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "romantic_inclination": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "intimacy_comfort": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "exclusivity": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "social_confidence": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "openness": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        }
      },
      "description": "points added to every generated profile's numbers"
    },
    "npcs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "manual",
              "automatic",
              "hybrid"
            ]
          },
          "values": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "libido": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "desire"
              },
              "sexual_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "confidence in intimacy"
              },
              "initiation": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "making the first move"
              },
              "selectiveness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "choosiness"
              },
              "privacy": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "privacy about her love life"
              },
              "romantic_inclination": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "romance"
              },
              "intimacy_comfort": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "ease with closeness"
              },
              "exclusivity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "faithfulness"
              },
              "social_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "ease with people"
              },
              "openness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "openness about her wants"
              },
              "relationship_style": {
                "enum": [
                  "romantic",
                  "balanced",
                  "casual"
                ],
                "description": "what she looks for"
              },
              "intimacy_pace": {
                "enum": [
                  "slow",
                  "moderate",
                  "quick"
                ],
                "description": "pace"
              },
              "relationship_dynamic": {
                "enum": [
                  "leads",
                  "equal",
                  "follows"
                ],
                "description": "who leads"
              },
              "intimacy_boundary": {
                "enum": [
                  "never",
                  "married_only",
                  "committed_only",
                  "after_courtship",
                  "casual_ok"
                ],
                "description": "when intimacy is right"
              },
              "attracted_to_sex": {
                "type": "array",
                "items": {
                  "enum": [
                    "male",
                    "female"
                  ]
                },
                "uniqueItems": true,
                "description": "drawn to"
              },
              "attracted_to": {
                "type": "array",
                "items": {
                  "enum": [
                    "kindness",
                    "courage",
                    "strength",
                    "wit",
                    "humour",
                    "confidence",
                    "ambition",
                    "loyalty",
                    "gentleness",
                    "intelligence",
                    "piety",
                    "wealth",
                    "honesty",
                    "mystery",
                    "magic",
                    "hard_work"
                  ]
                },
                "uniqueItems": true,
                "description": "what draws her"
              },
              "dislikes": {
                "type": "array",
                "items": {
                  "enum": [
                    "arrogance",
                    "cruelty",
                    "drunkenness",
                    "dishonesty",
                    "crude_talk",
                    "pushiness",
                    "cowardice",
                    "poor_hygiene",
                    "jealousy",
                    "recklessness",
                    "greed",
                    "lawbreaking"
                  ]
                },
                "uniqueItems": true,
                "description": "what puts her off"
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "enum": [
                    "no_public_affection",
                    "no_unasked_touch",
                    "no_drunk_advances",
                    "not_with_strangers",
                    "not_with_taken",
                    "no_crude_talk",
                    "no_rough_handling"
                  ]
                },
                "uniqueItems": true,
                "description": "her limits"
              }
            }
          },
          "private": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "attributes (or list items as 'boundaries:no_unasked_touch') she never shares"
          },
          "adult_confirmed": {
            "type": "boolean",
            "description": "she is an adult although the game gives no race; never overrides a child"
          },
          "plugin": {
            "type": "string"
          },
          "base_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "keyed by name ('Gerdur') or 'Plugin.esm|0x0001347C'"
    }
  }
}
